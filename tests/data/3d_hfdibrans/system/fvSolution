FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-10;
        relTol          0.0;
        smoother        symGaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 5;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    pFinal
    {
        $p;
        tolerance       1e-10;
        relTol          0;
    }

    "(U|k|epsilon|R|nuTilda)"
    {
        solver          PBiCG;
        preconditioner   DILU;
        tolerance       1e-30;
        relTol          0.0;
    }
    "(U|k|epsilon|R|nuTilda)Final"
    {
        solver          PBiCG;
        preconditioner   DILU;
        tolerance       1e-30;
        relTol          0;
    }
    omega
    {
        solver          PBiCG;
        preconditioner   DILU;
        tolerance       1e-20;
        relTol          0.0;
    }
    omegaFinal
    {
        solver          PBiCG;
        preconditioner   DILU;
        tolerance       1e-20;
        relTol          0.0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent yes;

    residualControl
    {
        U           1e-4;
    }

    HFDIB
    {
        U
        {
            surfaceType     switched;
            boundaryValue   1.0;
        }
    }
}

relaxationFactors
{
    fields
    {
        p           0.2;
        U           0.5;
        k           0.8;
        omega       0.8;
    }

    equations
    {
        ".*" 0.85;
    }
}

cache
{
    grad(U);
}

