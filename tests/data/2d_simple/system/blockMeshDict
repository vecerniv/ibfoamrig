FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 0.01;

cubeXYMin -2;
cubeXYMax 2;

cubeZMin -0.1;
cubeZMax 0.1;

XYresolution 20;
Zresolution  1;

vertices
(
  ($cubeXYMin       $cubeXYMin      $cubeZMin)
  ($cubeXYMax       $cubeXYMin      $cubeZMin)
  ($cubeXYMax       $cubeXYMax      $cubeZMin)
  ($cubeXYMin       $cubeXYMax      $cubeZMin)
  ($cubeXYMin       $cubeXYMin      $cubeZMax)
  ($cubeXYMax       $cubeXYMin      $cubeZMax)
  ($cubeXYMax       $cubeXYMax      $cubeZMax)
  ($cubeXYMin       $cubeXYMax      $cubeZMax)
);

blocks
(
  hex (0 1 2 3 4 5 6 7) ($XYresolution $XYresolution $Zresolution) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
front
{
  type patch;
  faces
  (
   (4 5 6 7)
  );
}
back
{
  type patch;
  faces
  (
   (0 3 2 1)
  );
}

outlet
{
type patch;
  faces
  (
  (2 6 5 1)
 );
}

inlet
{
type patch;
  faces
  (
  (0 4 7 3)
  );
}

walls
{
  type wall;
  faces
  (
  (0 1 5 4)
  (3 7 6 2)
  );
}
);

mergePatchPairs
(
);

