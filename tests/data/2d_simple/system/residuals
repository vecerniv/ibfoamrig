FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      residuals;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

residuals
{
    type                residuals;
    functionObjectLibs ("libutilityFunctionObjects.so");
    writeControl        timeStep;
    writeInterval       1;
    fields
    (
        U
        p
        k
        omega
		epsilon
    );
}

